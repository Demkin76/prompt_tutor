{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"], "@runtime/*": ["src/runtime/*"] }
  },
  "include": ["src", "app", "convex", "scripts"],
  "exclude": ["node_modules", "dist", "convex/_generated"]
}
