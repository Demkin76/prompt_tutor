# Convex (from `npx convex dev`)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# x.ai
XAI_API_KEY=
XAI_MODEL=grok-4-fast
# Daytona (optional; if absent the run executes in-process inside a Convex action)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Frontend build: leave unset for live production. build:demo sets this explicitly.
VITE_DEMO_MODE=
# Optional subpath for static hosting, e.g. /prompt_tutor/
BASE_URL=/
